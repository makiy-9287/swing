# ==== Sniper Signals configuration ====
# Copy this file to ".env" and fill in your values.

# --- Telegram (required) ---
# 1. Talk to @BotFather -> /newbot -> copy the token here.
# 2. Push destination: your numeric user id, a group id (negative), or a channel like @mychannel.
#    Get your numeric id from @userinfobot. For a channel, add the bot as admin.
TELEGRAM_BOT_TOKEN=8893521930:AAHh4kFLjh_PWLWzkCcu8OepukqKOJVWipw
TELEGRAM_CHAT_ID=5530953384

# Optional: restrict who can use bot commands (comma separated numeric user ids).
# Leave blank to allow everyone. The push channel above always receives signals.
ALLOWED_USER_IDS=

# --- Universe filter ---
# Only scan USDT-perpetuals with 24h quote volume above this (USDT).
MIN_QUOTE_VOLUME=10000000
# Symbols to always skip (comma separated), e.g. stable pairs / low-quality.
EXCLUDE_SYMBOLS=USDCUSDT,BTCDOMUSDT

# --- Scanning cadence ---
SCAN_INTERVAL=1500      # seconds between full scans
UNIVERSE_REFRESH=20000       # seconds between volume/universe refreshes
CONCURRENCY=12              # max simultaneous Binance requests

# --- Multi-timeframe set ---
TF_HTF=1d                   # higher-timeframe bias
TF_MTF=4h                   # structure / zone timeframe
TF_LTF=1h                  # entry trigger timeframe
KLINE_LIMIT=400             # candles fetched per timeframe

# --- Signal gating ---
MIN_SCORE=10                # minimum confluence score to emit (0-10 scale)
SIGNAL_COOLDOWN=14000        # seconds before the same symbol+strategy+side can fire again
MAX_SIGNALS_PER_CYCLE=8     # safety cap on alerts per scan

# --- Trade tracker / monitor ---
# Every broadcast signal is tracked as a paper trade (entry -> TP1/2/3 / SL).
# The /pnl command reports win rate, R multiples and running trades.
TRACK_TRADES=true           # master switch for the tracker + /pnl
TRACK_INTERVAL=60           # seconds between price checks on open trades
TRACK_TF=1m                 # candle interval used to detect fills/TP/SL (closed candles)
ENTRY_TIMEOUT=15000      # cancel a signal if its entry never fills within this many seconds (12h)
MOVE_SL_TO_BE=true          # move stop to break-even after TP1 is banked
